rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'mge3696@gmail.com';
    }

    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function canEditDashboard() {
      return isOwner() || isStaff();
    }

    function validOrderCreate() {
      return request.resource.data.keys().hasAll([
          'number', 'items', 'customer', 'fulfillment', 'paymentMethod',
          'status', 'totals', 'lang', 'createdAt'
        ])
        && request.resource.data.number is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() < 40
        && request.resource.data.customer.keys().hasAll([
          'name', 'phone', 'city', 'address', 'notes'
        ])
        && request.resource.data.customer.name is string
        && request.resource.data.customer.name.size() > 0
        && request.resource.data.customer.name.size() < 120
        && request.resource.data.customer.phone is string
        && request.resource.data.customer.phone.size() >= 8
        && request.resource.data.customer.phone.size() < 24
        && request.resource.data.fulfillment in ['delivery', 'pickup']
        && request.resource.data.paymentMethod in ['cod', 'instapay', 'whatsapp']
        && request.resource.data.status == 'new'
        && request.resource.data.lang in ['ar', 'en']
        && request.resource.data.createdAt is int;
    }

    match /config/store {
      allow read: if true;
      allow write: if canEditDashboard();
    }

    match /config/site {
      allow read: if true;
      allow write: if canEditDashboard();
    }

    match /config/auditSettings {
      allow read: if canEditDashboard();
      allow write: if isOwner()
        && request.resource.data.keys().hasOnly(['retentionDays'])
        && request.resource.data.retentionDays is int
        && request.resource.data.retentionDays >= 1
        && request.resource.data.retentionDays <= 365;
    }

    function isStockOnlyDecrement() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stock', 'updatedAt'])
        && request.resource.data.stock is int
        && request.resource.data.updatedAt is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock
        && resource.data.stock - request.resource.data.stock <= 40;
    }

    match /products/{id} {
      allow read: if true;
      allow create, delete: if canEditDashboard();
      // Checkout API uses the public web SDK (no Admin), so allow a
      // constrained stock decrement when an order is placed.
      allow update: if canEditDashboard() || isStockOnlyDecrement();
    }

    match /categories/{id} {
      allow read: if true;
      allow create, update, delete: if canEditDashboard();
    }

    match /orders/{id} {
      allow read: if canEditDashboard()
        || (request.auth == null && false);
      allow get: if true;
      allow list: if canEditDashboard();
      allow create: if validOrderCreate();
      allow update: if canEditDashboard();
      allow delete: if isOwner();
    }

    match /admins/{uid} {
      allow read: if canEditDashboard();
      allow create: if canEditDashboard()
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() < 320;
      allow update: if request.auth.uid == uid
        && canEditDashboard()
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() < 320;
      allow delete: if isOwner()
        && uid != request.auth.uid
        && resource.data.email != 'mge3696@gmail.com';
    }

    match /errorLogs/{id} {
      allow read: if canEditDashboard();
      allow create: if request.resource.data.keys().hasOnly([
          'message', 'stack', 'source', 'path', 'status', 'digest', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 800
        && request.resource.data.stack is string
        && request.resource.data.stack.size() < 2500
        && request.resource.data.source in ['server', 'client', 'api']
        && request.resource.data.path is string
        && request.resource.data.path.size() < 400
        && request.resource.data.status is int
        && request.resource.data.digest is string
        && request.resource.data.digest.size() < 120
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time + duration.value(12, 'h')
        && request.resource.data.expiresAt < request.time + duration.value(31, 'd');
      allow update: if false;
      allow delete: if isOwner()
        || (canEditDashboard()
          && resource.data.expiresAt is timestamp
          && resource.data.expiresAt < request.time);
    }

    match /auditLogs/{id} {
      allow read: if isOwner()
        || (request.auth != null
          && resource.data.expiresAt is timestamp
          && resource.data.expiresAt < request.time);
      allow create: if canEditDashboard()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail is string
        && request.resource.data.action is string
        && request.resource.data.summary is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time + duration.value(12, 'h')
        && request.resource.data.expiresAt < request.time + duration.value(366, 'd');
      allow update: if false;
      allow delete: if isOwner()
        || (request.auth != null
          && resource.data.expiresAt is timestamp
          && resource.data.expiresAt < request.time);
    }

    match /stats/{document=**} {
      allow read: if canEditDashboard();
      allow write: if canEditDashboard();
    }

    match /applications/{id} {
      allow read, write: if canEditDashboard();
    }
  }
}
